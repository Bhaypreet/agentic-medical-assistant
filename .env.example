# Copy this file to a local environment file and fill it in.
# Required values abort startup if missing.

# ---- environment -------------------------------------------------------
# development | staging | production
ENVIRONMENT=development

# ---- credentials -------------------------------------------------------
# Required. Get one at https://console.groq.com
GROQ_API_KEY=

# Pepper for every stored password hash and sign-in token.
# REQUIRED in production, minimum 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Changing it invalidates every password and every session, so set it
# once per deployment and keep it.
SECRET_KEY=

# Optional machine keys for service-to-service callers, sent on
# X-API-Key. People sign in with a username and password instead, so
# this is usually left empty.
API_KEYS=

# ---- accounts ----------------------------------------------------------
ALLOW_REGISTRATION=true
MIN_PASSWORD_LENGTH=10
AUTH_TOKEN_TTL_HOURS=336
LOGIN_RATE_LIMIT=10/minute

# ---- http --------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
CHAT_RATE_LIMIT=20/minute
UPLOAD_RATE_LIMIT=5/minute
TRANSCRIBE_RATE_LIMIT=10/minute

# ---- storage -----------------------------------------------------------
# SQLite is fine for a single instance, but the filesystem is ephemeral on
# most hosts - accounts and chats reset on every deploy. Point at Postgres
# for anything real:
#   postgresql+psycopg://user:pass@host:5432/medassist
DATABASE_URL=sqlite:///./sessions.db

# ---- limits ------------------------------------------------------------
MAX_UPLOAD_BYTES=15728640
MAX_REPORT_PAGES=25
REPORT_RETENTION_HOURS=24

# ---- observability -----------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=

# Logs raw OCR text and raw model output. This is patient data.
# The config refuses to start if this is true while ENVIRONMENT=production.
DEBUG_LOG_REPORT_CONTENT=false

# ---- frontend ----------------------------------------------------------
# Set in Streamlit secrets when deploying the frontend separately.
FASTAPI_URL=http://127.0.0.1:8000
