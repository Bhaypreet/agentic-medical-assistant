# Copy this file to a local environment file and fill it in.
# Required values abort startup if missing.

# ---- environment -------------------------------------------------------
# development | staging | production
ENVIRONMENT=development

# ---- credentials -------------------------------------------------------
# Required. Get one at https://console.groq.com
GROQ_API_KEY=

# Comma-separated keys accepted on the X-API-Key header.
# Optional in development (auth is then disabled); REQUIRED in production.
API_KEYS=

# ---- http --------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
CHAT_RATE_LIMIT=20/minute
UPLOAD_RATE_LIMIT=5/minute
TRANSCRIBE_RATE_LIMIT=10/minute

# ---- storage -----------------------------------------------------------
# SQLite is fine for a single instance; point at Postgres for real deploys:
#   postgresql+psycopg://user:pass@host:5432/medassist
DATABASE_URL=sqlite:///./sessions.db

# ---- limits ------------------------------------------------------------
MAX_UPLOAD_BYTES=15728640
MAX_REPORT_PAGES=25
REPORT_RETENTION_HOURS=24

# ---- observability -----------------------------------------------------
LOG_LEVEL=INFO
SENTRY_DSN=

# Logs raw OCR text and raw model output. This is patient data.
# The config refuses to start if this is true while ENVIRONMENT=production.
DEBUG_LOG_REPORT_CONTENT=false

# ---- frontend ----------------------------------------------------------
FASTAPI_URL=http://127.0.0.1:8000
